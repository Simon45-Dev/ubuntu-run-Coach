// Ubuntu Run coaching platform - core data model.
// Every entity here maps back to Section 7 of the product planning document.
// Tables for Group/TrainingPlan/Workout/WorkoutResult/RaceGoal/Message/Notification
// exist now so later slices aren't blocked by migrations, but have no API yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganisationType {
  SOLO
  CLUB
}

enum Role {
  PLATFORM_ADMIN
  COACH
  ATHLETE
  CLUB_MEMBER
  CLUB_ADMIN
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MfaType {
  TOTP
}

enum PbSource {
  SELF_REPORTED
  VERIFIED
}

enum TrainingPlanPhase {
  BASE
  BUILD
  PEAK
  TAPER
  RECOVERY
}

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum WorkoutType {
  EASY
  TEMPO
  INTERVAL
  LONG_RUN
  RACE
  REST
  CROSS_TRAIN
}

enum RaceGoalStatus {
  PLANNED
  COMPLETED
  DNF
  CANCELLED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ConsentType {
  HEALTH_CHECKIN_DATA
  TERMS_OF_SERVICE
}

// ---------------------------------------------------------------------------
// Organisation / Subscription
// ---------------------------------------------------------------------------

/// Sits above Coach and owns Subscription. v1 UX only ever creates one-coach
/// organisations, but the shape supports multiple coaches per org (Stage 7:
/// clubs / larger coaching businesses) without a later schema rewrite.
model Organisation {
  id     String           @id @default(uuid())
  name   String
  type   OrganisationType @default(SOLO)

  /// Atomic per-club counter for ClubMember.membershipNumber - always
  /// incremented via a single UPDATE...RETURNING inside the create
  /// transaction (ClubMembersService.create), never read-then-written, so
  /// concurrent member creation can never collide.
  nextMembershipNumber Int @default(0)

  coaches       Coach[]
  subscriptions Subscription[]
  clubMembers   ClubMember[]
  clubAdmins    ClubAdmin[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("organisations")
}

model Subscription {
  id                  String              @id @default(uuid())
  organisationId      String
  organisation        Organisation        @relation(fields: [organisationId], references: [id])
  planName            String
  status              SubscriptionStatus  @default(TRIALING)
  startDate           DateTime
  renewalDate         DateTime?
  athleteLimit        Int
  coachLimit          Int                 @default(1)
  billingProvider     String?
  externalCustomerId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organisationId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  passwordHash       String
  name               String
  role               Role
  status             UserStatus @default(INVITED)
  mfaEnabled         Boolean    @default(false)
  mfaSecretEncrypted String?
  mfaType            MfaType?
  lastLoginAt        DateTime?
  avatarUrl          String?

  /// Set only while an invite is pending (status = INVITED); cleared once
  /// accepted. See AthletesService.invite/resendInvite and
  /// AuthService.acceptInvite.
  inviteTokenHash      String?   @unique
  inviteTokenExpiresAt DateTime?

  /// Set only while a password reset is pending; cleared once used. Kept
  /// separate from the invite fields above since reset must work for an
  /// already-ACTIVE user, not just one in INVITED status. See
  /// AuthService.forgotPassword/resetPassword.
  passwordResetTokenHash      String?   @unique
  passwordResetTokenExpiresAt DateTime?

  coachProfile      Coach?
  athleteProfile    Athlete?
  clubMemberProfile ClubMember?
  clubAdminProfile  ClubAdmin?
  refreshTokens     RefreshToken[]
  sentMessages      Message[]      @relation("SentMessages")
  receivedMessages  Message[]      @relation("ReceivedMessages")
  notifications     Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Coach {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id])
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id])
  bio             String?
  experienceYears Int?
  athleteLimit    Int?

  athletes              Athlete[]
  groups                Group[]
  trainingPlans         TrainingPlan[]
  trainingPlanTemplates TrainingPlanTemplate[]
  coachNotes            CoachNote[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organisationId])
  @@map("coaches")
}

/// Health-adjacent personal information (CheckIn) hangs off Athlete. Access to
/// that subset is enforced more strictly than ordinary training data - see
/// HealthDataScopeGuard and the Consent model below.
model Athlete {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  coachId            String?
  coach              Coach?   @relation(fields: [coachId], references: [id])
  // Denormalised from coach for cheap/direct scoping queries - see
  // buildAthleteScopeFilter() in src/common/scope/scope-filters.ts.
  organisationId     String?
  goal               String?
  availability       Json?
  trainingBackground String?

  personalBests    PersonalBest[]
  checkIns         CheckIn[]
  raceGoals        RaceGoal[]
  consents         Consent[]
  groupMemberships GroupMembership[]
  workoutResults   WorkoutResult[]
  trainingPlans    TrainingPlan[]
  coachNotes       CoachNote[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([coachId])
  @@index([organisationId])
  @@map("athletes")
}

/// A separate concept from Athlete - someone can join a club (pay dues, get
/// a membership number) without ever being coached or on a training plan.
/// userId is nullable: a coach/admin can capture a member's details with no
/// login at all, or invite them to self-service via ClubMembersService.invite
/// (mirrors AthletesService.invite) - both paths are supported.
model ClubMember {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])

  /// System-generated only (ClubMembersService.create) - never accepted from
  /// a client. Unique per club, not globally - see @@unique below.
  membershipNumber String
  firstName        String
  lastName         String
  idNumber         String?
  email            String
  phone            String?
  dateOfBirth      DateTime?
  address          String?

  /// Overridable at creation (a club backfilling a member's real historical
  /// join date) - defaults to creation time otherwise.
  joinDate DateTime @default(now())

  /// Coach/admin-controlled only - ClubMembersService.update rejects a
  /// CLUB_MEMBER caller trying to set either of these themselves.
  membershipExpiryDate DateTime?
  lastRenewalDate      DateTime?

  /// Set when an expiry reminder email is sent; reset to null whenever
  /// membershipExpiryDate changes, so a renewal re-arms future reminders
  /// instead of the member being silently skipped forever. See
  /// ClubMembersService.sendExpiryReminders/update.
  lastReminderSentAt DateTime?

  nextOfKinName         String?
  nextOfKinPhone        String?
  nextOfKinRelationship String?

  payments ClubMemberPayment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organisationId, membershipNumber])
  @@index([organisationId])
  @@map("club_members")
}

enum PaymentMethod {
  CASH
  EFT
  CARD
  OTHER
}

/// Record-keeping only - no payment gateway integration. A coach/admin logs
/// that a payment happened; no money actually moves through the app.
model ClubMemberPayment {
  id                String        @id @default(uuid())
  clubMemberId      String
  clubMember        ClubMember    @relation(fields: [clubMemberId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod
  paidAt            DateTime
  note              String?
  recordedByUserId  String

  createdAt DateTime @default(now())

  @@index([clubMemberId])
  @@map("club_member_payments")
}

/// Scoped to one organisation; can manage that organisation's club
/// membership (roster, CSV import, payments, expiry reminders) but has no
/// access to athletes, training plans, or other coaching data - see
/// buildClubMemberScopeFilter and the deliberate absence of CLUB_ADMIN from
/// buildAthleteScopeFilter/buildTrainingPlanScopeFilter/buildCoachScopeFilter
/// in src/common/scope/scope-filters.ts. userId is required (unlike
/// ClubMember) - a row here is only ever created via the invite flow
/// alongside its User, the same as Coach.
model ClubAdmin {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organisationId])
  @@map("club_admins")
}

model PersonalBest {
  id            String    @id @default(uuid())
  athleteId     String
  athlete       Athlete   @relation(fields: [athleteId], references: [id])
  distance      String
  timeSeconds   Int
  achievedDate  DateTime?
  source        PbSource  @default(SELF_REPORTED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([athleteId])
  @@map("personal_bests")
}

// ---------------------------------------------------------------------------
// Consent (backs the stricter access rule for CheckIn / health-adjacent data)
// ---------------------------------------------------------------------------

/// A history table rather than a single timestamp field, because consent can
/// be granted, later withdrawn, and re-granted under a new policy version.
model Consent {
  id            String      @id @default(uuid())
  athleteId     String
  athlete       Athlete     @relation(fields: [athleteId], references: [id])
  consentType   ConsentType
  policyVersion String
  grantedAt     DateTime    @default(now())
  withdrawnAt   DateTime?

  checkIns CheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// Schema-only still: RaceGoal, Notification. No controllers/services yet.
// TrainingPlan, Workout, WorkoutResult, CheckIn, Message, Group all have APIs.
// ---------------------------------------------------------------------------

model Group {
  id                 String  @id @default(uuid())
  organisationId     String
  coachId            String
  coach              Coach   @relation(fields: [coachId], references: [id])
  name               String
  programmeTemplateId String?

  memberships   GroupMembership[]
  trainingPlans TrainingPlan[]
  messages      Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([coachId])
  @@index([organisationId])
  @@map("groups")
}

model GroupMembership {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  joinedAt  DateTime @default(now())

  @@unique([groupId, athleteId])
  @@map("group_memberships")
}

model TrainingPlan {
  id          String              @id @default(uuid())
  organisationId String
  coachId     String
  coach       Coach               @relation(fields: [coachId], references: [id])
  athleteId   String?
  athlete     Athlete?            @relation(fields: [athleteId], references: [id])
  groupId     String?
  group       Group?              @relation(fields: [groupId], references: [id])
  name        String
  startDate   DateTime
  endDate     DateTime?
  goal        String?
  phase       TrainingPlanPhase?
  version     Int                 @default(1)
  status      TrainingPlanStatus  @default(DRAFT)

  /// Provenance only - which template (if any) this plan was created from.
  /// Never edited after creation; the plan is an independent copy, not a
  /// live reference, so later changes to the template don't affect it.
  sourceTemplateId String?
  sourceTemplate   TrainingPlanTemplate? @relation(fields: [sourceTemplateId], references: [id])

  workouts Workout[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([coachId])
  @@index([athleteId])
  @@index([groupId])
  @@map("training_plans")
}

model Workout {
  id                String       @id @default(uuid())
  trainingPlanId    String
  trainingPlan      TrainingPlan @relation(fields: [trainingPlanId], references: [id])
  scheduledDate     DateTime
  type              WorkoutType
  distanceTargetKm  Decimal?
  durationTargetSec Int?
  paceTarget        String?
  hrZoneTarget      String?
  rpeTarget         Int?
  instructions      String?

  results WorkoutResult[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([trainingPlanId])
  @@map("workouts")
}

/// One row per (workout, athlete) - not one per workout - so a group-assigned
/// workout can carry an independent result for each member. Individual-plan
/// workouts only ever have one athlete anyway, so this is a strict superset
/// of the old workoutId-only-unique behaviour, not a narrowing of it.
model WorkoutResult {
  id                String   @id @default(uuid())
  workoutId         String
  workout           Workout  @relation(fields: [workoutId], references: [id])
  athleteId         String
  athlete           Athlete  @relation(fields: [athleteId], references: [id])
  actualDistanceKm  Decimal?
  actualDurationSec Int?
  actualPace        String?
  avgHr             Int?
  maxHr             Int?
  rpe               Int?
  comments          String?
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workoutId, athleteId])
  @@index([workoutId])
  @@index([athleteId])
  @@map("workout_results")
}

/// A reusable, coach-owned skeleton - never athlete-facing. Workouts are
/// defined by day offset from an eventual start date, not real dates, since
/// a template has no start date of its own until it's applied.
model TrainingPlanTemplate {
  id             String             @id @default(uuid())
  organisationId String
  coachId        String
  coach          Coach              @relation(fields: [coachId], references: [id])
  name           String
  goal           String?
  phase          TrainingPlanPhase?

  workouts     TemplateWorkout[]
  plansCreated TrainingPlan[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([coachId])
  @@index([organisationId])
  @@map("training_plan_templates")
}

/// No deletedAt - applying a template copies its data into real Workout
/// rows, so nothing ever references a TemplateWorkout row directly; removing
/// one from a template is a plain hard delete.
model TemplateWorkout {
  id                String               @id @default(uuid())
  templateId        String
  template          TrainingPlanTemplate @relation(fields: [templateId], references: [id])
  dayOffset         Int
  type              WorkoutType
  distanceTargetKm  Decimal?
  durationTargetSec Int?
  paceTarget        String?
  hrZoneTarget      String?
  rpeTarget         Int?
  instructions      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@map("template_workouts")
}

/// Health-adjacent personal information. Every row requires a live linked
/// Consent - enforced at the application layer by HealthDataScopeGuard, not
/// just by the presence of consentId here.
model CheckIn {
  id           String   @id @default(uuid())
  athleteId    String
  athlete      Athlete  @relation(fields: [athleteId], references: [id])
  date         DateTime
  sleepQuality Int?
  energy       Int?
  soreness     Int?
  stress       Int?
  motivation   Int?
  pain         String?
  consentId    String
  consent      Consent  @relation(fields: [consentId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([athleteId, date])
  @@index([athleteId])
  @@map("check_ins")
}

model RaceGoal {
  id                String         @id @default(uuid())
  athleteId         String
  athlete           Athlete        @relation(fields: [athleteId], references: [id])
  raceName          String
  raceDate          DateTime
  distance          String
  targetTimeSeconds Int?
  status            RaceGoalStatus @default(PLANNED)
  actualTimeSeconds Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([athleteId])
  @@map("race_goals")
}

/// Private to the authoring coach - never athlete-visible. Edit/delete
/// rights belong to whoever wrote it (coachId), not whoever currently
/// coaches the athlete - see CoachNotesService.
model CoachNote {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id])
  coachId   String
  coach     Coach   @relation(fields: [coachId], references: [id])
  content   String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([athleteId])
  @@index([coachId])
  @@map("coach_notes")
}

model Message {
  id         String    @id @default(uuid())
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String?
  receiver   User?     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  groupId    String?
  group      Group?    @relation(fields: [groupId], references: [id])
  content    String
  sentAt     DateTime  @default(now())
  readAt     DateTime?

  @@index([senderId])
  @@index([receiverId])
  @@index([groupId])
  @@map("messages")
}

model Notification {
  id          String               @id @default(uuid())
  recipientId String
  recipient   User                 @relation(fields: [recipientId], references: [id])
  type        String
  priority    NotificationPriority @default(MEDIUM)
  status      NotificationStatus   @default(PENDING)
  payload     Json?
  sentAt      DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit log - append-only. No update/delete route is ever exposed for this.
// ---------------------------------------------------------------------------

model AuditLog {
  id              String   @id @default(uuid())
  actorUserId     String?
  action          String
  targetEntityType String
  targetEntityId  String
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([actorUserId])
  @@index([targetEntityType, targetEntityId])
  @@map("audit_logs")
}
