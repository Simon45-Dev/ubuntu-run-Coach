# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database (Postgres). Confirm hosting region/provider offers POPIA-compatible
# data residency and a signed data processing agreement before pointing this
# at any environment holding real personal information.
DATABASE_URL=postgresql://ubuntu_run:ubuntu_run@localhost:5432/ubuntu_run_dev

# Auth - generate strong random secrets per environment, never reuse across environments
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# MFA - used to encrypt stored TOTP secrets at rest
MFA_ENCRYPTION_KEY=change-me-32-byte-hex-key

# Email (Brevo HTTP API) - optional. Leave BREVO_API_KEY unset to log
# invite/reset emails to the server console instead of sending them (dev-safe
# default). Uses Brevo's HTTP API rather than SMTP because Render's free web
# service blocks outbound SMTP ports - see docs/deployment.md.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@ubunturun.dev
EMAIL_FROM_NAME=Ubuntu Run

# File storage (avatars) - optional. Leave these unset to store uploaded
# avatars on local disk instead (dev-safe default, but not suitable for hosts
# without a persistent disk - see docs/deployment.md). Any S3-compatible
# provider works (Backblaze B2, Cloudflare R2, etc); the bucket should be
# PRIVATE - avatars are served back out via GET /avatars/:filename.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
